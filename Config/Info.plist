<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. velvet://open?url=<YouTube link> opens the link
	     in Velvet (the bookmarklet in Settings › General uses it). Velvet does not claim
	     http or https, so it never becomes a browser choice. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.subhash.Velvet.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>velvet</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
