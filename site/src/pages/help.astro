const toc = [
  { id: 'first-open', label: 'macOS stops Velvet' },
  { id: 'which-download', label: 'Find the correct download' },
  { id: 'first-start', label: 'Download on the first start' },
  { id: 'no-playback', label: 'Videos do not play' },
  { id: 'buffering', label: 'A video stops to load' },
  { id: 'search-history', label: 'Few past searches' },
  { id: 'pip-timeline', label: 'Picture in Picture timeline' },
  { id: 'intel', label: 'Intel Macs' },
