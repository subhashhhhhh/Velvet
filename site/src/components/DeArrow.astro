---
const filters = ['Videos that you watched', 'Members-only videos', 'Promotions', 'The Breaking news group on Home', 'Channels that post AI-generated videos'];
---

<section class="section" id="calm">
  <div class="wrap grid">
    <div class="demo" data-dearrow>
      <div class="card">
        <div class="thumb">
          <div class="bait" aria-hidden="true">
            <span class="shout">I QUIT<br />MY JOB?!</span>
            <span class="ring"></span>
            <span class="pointer">➜</span>
          </div>
          <div class="calm" aria-hidden="true">
            <span class="sun"></span>
            <span class="hill h1"></span>
            <span class="hill h2"></span>
          </div>
          <span class="len mono">14:02</span>
        </div>
        <div class="text">
          <span class="avatar" aria-hidden="true"></span>
          <div>
            <p class="titles">
              <span class="t-bait">I Tried Waking Up at 4AM for 30 DAYS… (You WON'T Believe What Happened)</span>
              <span class="t-calm">What changed after a month of waking up at 4&nbsp;a.m.</span>
            </p>
            <p class="by">A channel · 1.2M views · 3 days ago</p>
          </div>
        </div>
      </div>
      <div class="under">
        <button type="button" class="switch" data-dearrow-toggle role="switch" aria-checked="true">
          <span class="knob" aria-hidden="true"></span>
          <span>DeArrow</span>
        </button>
        <p class="fine">An invented video, to show the change</p>
      </div>
    </div>

    <div class="head">
      <p class="label" data-reveal>A calmer feed</p>
      <h2 class="title" data-reveal>Less shouting, more watching</h2>
      <p class="lede" data-reveal>
        DeArrow replaces clickbait titles and thumbnails with better ones from its community. Return YouTube Dislike
        shows the dislike counts. Velvet can also hide what you do not want in your feed.
      </p>
      <ul class="filters">
        {filters.map((f) => <li data-reveal>{f}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  const demo = document.querySelector<HTMLElement>('[data-dearrow]');
  const toggle = demo?.querySelector<HTMLButtonElement>('[data-dearrow-toggle]');
  if (demo && toggle) {
    let touched = false;
    const set = (on: boolean) => {
      demo.classList.toggle('on', on);
      toggle.setAttribute('aria-checked', String(on));
    };
    toggle.addEventListener('click', () => {
      touched = true;
      set(!demo.classList.contains('on'));
    });
    // Show the clickbait first, then turn DeArrow on when the card is in view.
    set(false);
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !touched) {
          setTimeout(() => !touched && set(true), 1100);
          io.disconnect();
        }
      },
      { threshold: 0.7 },
    );
    io.observe(demo);
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: 64px;
  }

  .head {
    margin-bottom: 0;
  }

  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    max-width: 440px;
    width: 100%;
  }

  .card {
    padding: 12px 12px 16px;
    border-radius: 20px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
  }

  .bait,
  .calm {
    position: absolute;
    inset: 0;
    transition: opacity 500ms var(--ease);
  }

  /* The loud thumbnail is the point of the demo: this is what DeArrow takes away. */
  .bait {
    background:
      radial-gradient(circle at 78% 40%, #fff200 0 18%, transparent 19%),
      conic-gradient(from 20deg at 30% 60%, #ff2d00, #ff9d00, #ff005d, #ff2d00);
  }

  .shout {
    position: absolute;
    left: 6%;
    top: 12%;
    font-family: Impact, 'Arial Black', sans-serif;
    font-size: clamp(26px, 5.4vw, 44px);
    line-height: 0.95;
    color: #fff;
    -webkit-text-stroke: 2px #000;
    paint-order: stroke fill;
    text-shadow: 4px 4px 0 #000;
    transform: rotate(-5deg);
  }

  .ring {
    position: absolute;
    right: 12%;
    top: 22%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 5px solid #f00;
  }

  .pointer {
    position: absolute;
    right: 36%;
    top: 34%;
    font-size: clamp(30px, 6vw, 52px);
    color: #f00;
    -webkit-text-stroke: 2px #fff;
    transform: rotate(-12deg);
  }

  .calm {
    background: linear-gradient(180deg, #1c2a4a 0%, #51466f 46%, #d98a6a 78%, #f3c98b 100%);
    opacity: 0;
  }

  .sun {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 16%;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: -50% -50%;
    background: #ffe6b0;
  }

  .hill {
    position: absolute;
    bottom: -42%;
    border-radius: 50%;
  }

  .h1 {
    left: -20%;
    width: 90%;
    aspect-ratio: 2 / 1;
    background: #2b2440;
  }

  .h2 {
    right: -30%;
    width: 110%;
    aspect-ratio: 2 / 1;
    bottom: -52%;
    background: #1b172b;
  }

  .len {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 0 6px;
    border-radius: 4px;
    background: rgba(18, 17, 15, 0.8);
    font-size: 12px;
    line-height: 20px;
  }

  .text {
    display: flex;
    gap: 12px;
    margin-top: 12px;
    padding-inline: 4px;
  }

  .avatar {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--raised);
  }

  .titles {
    display: grid;
    font-weight: 500;
    font-size: 16px;
    line-height: 22px;
  }

  .titles span {
    grid-area: 1 / 1;
    transition:
      opacity 400ms var(--ease),
      transform 400ms var(--ease);
  }

  .t-calm {
    opacity: 0;
    transform: translateY(8px);
  }

  .by {
    margin-top: 4px;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-3);
  }

  .demo:global(.on) .bait {
    opacity: 0;
  }

  .demo:global(.on) .calm {
    opacity: 1;
  }

  .demo:global(.on) .t-bait {
    opacity: 0;
    transform: translateY(-8px);
  }

  .demo:global(.on) .t-calm {
    opacity: 1;
    transform: none;
  }

  .under {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-inline: 4px;
  }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
  }

  .knob {
    position: relative;
    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line-2);
    transition: background-color 160ms var(--ease);
  }

  .knob::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--ink);
    transition: transform 160ms var(--ease);
  }

  .demo:global(.on) .knob {
    background: var(--accent);
    box-shadow: none;
  }

  .demo:global(.on) .knob::after {
    transform: translateX(16px);
  }

  .fine {
    font-size: 13px;
    line-height: 20px;
    color: var(--ink-3);
  }

  .filters {
    display: grid;
    margin-top: 8px;
    border-top: 1px solid var(--line);
  }

  .filters li {
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 20px;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .demo {
      order: 2;
    }
  }
</style>
