---
import { Picture } from 'astro:assets';
import watch from '../assets/watch.png';
import CopyCommand from './CopyCommand.astro';
import { brew } from '../data';
---

<section class="hero" id="top" data-hero>
  <div class="wrap inner">
    <div class="text" data-hero-text>
      <h1 data-hero-title>YouTube, without the weight</h1>
      <p class="sub" data-hero-fade>
        A native Mac app for your YouTube account that plays the same video in about a quarter of a browser tab's memory
      </p>
      <div class="actions" data-hero-fade>
        <a class="btn btn-primary" href="/download">Download for Mac</a>
        <CopyCommand command={brew} />
      </div>
    </div>
  </div>

  <div class="screen" data-hero-window>
    <Picture
      src={watch}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[720, 1080, 1440, 2160, 2720]}
      sizes="(max-width: 1240px) 94vw, 1184px"
      alt="The Velvet window: a video plays at the left, with related videos and Shorts in a column at the right."
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  /* Default layout (also without scripts, with reduced motion and on small screens):
     the text, then the whole window below it. */
  .hero {
    position: relative;
    padding-top: calc(var(--nav) + 96px);
  }

  .text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    max-width: 560px;
  }

  h1 {
    font-size: 64px;
    line-height: 66px;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .sub {
    font-size: 19px;
    line-height: 28px;
    color: var(--ink-2);
    max-width: 30rem;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .screen {
    width: min(var(--max), 100% - var(--gutter) * 2);
    margin: 64px auto 0;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px var(--line-2),
      0 32px 64px rgba(0, 0, 0, 0.5);
  }

  .screen :global(img) {
    width: 100%;
    border-radius: inherit;
  }

  /* Wide screens with motion: the room. The text sits at the left and the window, the one
     lit thing, runs off the right edge. Scrolling brings it to the centre (the script
     drives the transform; these are its start values). */
  :global(html.pin-hero) .hero {
    height: 100svh;
    min-height: 640px;
    padding-top: var(--nav);
    overflow: clip;
  }

  :global(html.pin-hero) .inner {
    display: flex;
    align-items: center;
    height: 100%;
    padding-bottom: 32px;
  }

  :global(html.pin-hero) .text {
    width: calc(52vw - var(--gutter) - 48px);
    max-width: 576px;
  }

  :global(html.pin-hero) .screen {
    position: absolute;
    top: calc(var(--nav) + (100% - var(--nav)) / 2);
    left: 52%;
    width: min(var(--max), 100vw - var(--gutter) * 2, (100svh - var(--nav) - 64px) * 1.789);
    margin: 0;
    transform: translateY(-50%) scale(0.9);
    transform-origin: 0 50%;
    will-change: transform;
  }

  @media (max-width: 1240px) {
    h1 {
      font-size: 56px;
      line-height: 60px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: calc(var(--nav) + 48px);
    }

    h1 {
      font-size: 40px;
      line-height: 44px;
      letter-spacing: -0.02em;
    }

    .sub {
      font-size: 17px;
      line-height: 26px;
    }

    .screen {
      margin-top: 48px;
      border-radius: 8px;
    }
  }
</style>
