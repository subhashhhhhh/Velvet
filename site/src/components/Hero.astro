---
import { Picture } from 'astro:assets';
import watch from '../assets/watch.png';
import CopyCommand from './CopyCommand.astro';
import { brew, version } from '../data';
---

<section class="hero" id="top">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap copy">
    <p class="eyebrow" data-hero-fade>A native YouTube client for macOS</p>
    <h1 class="title" data-hero-title>YouTube, without<br /><em>the weight.</em></h1>
    <p class="lede" data-hero-fade>
      Your feed, your subscriptions and your history, in a real Mac app. Velvet plays the same video in a fraction of
      the memory that a browser tab needs.
    </p>
    <div class="cta" data-hero-fade>
      <a class="btn btn-primary" href="#install">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16.500h12"></path>
        </svg>
        Download for Mac
      </a>
      <CopyCommand command={brew} />
    </div>
    <p class="meta" data-hero-fade>
      Version {version} <span>·</span> macOS 15 or later <span>·</span> Apple silicon and Intel <span>·</span> Free and open
      source
    </p>
  </div>

  <div class="wrap stage-wrap">
    <div class="stage" data-hero-stage>
      <div class="window" data-hero-window>
        <Picture
          src={watch}
          formats={['avif']} fallbackFormat="webp"
          widths={[720, 1080, 1440, 2160, 2720]}
          sizes="(max-width: 1240px) 94vw, 1180px"
          alt="The Velvet window: a video plays at the left, with related videos and Shorts in a column at the right."
          loading="eager"
          fetchpriority="high"
        />
        <span class="sheen" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(112px, 12vw, 164px);
    padding-bottom: clamp(48px, 8vw, 96px);
  }

  .glow {
    position: absolute;
    inset: -10% 0 auto 0;
    height: 900px;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(224, 16, 58, 0.2), transparent 70%),
      radial-gradient(40% 36% at 78% 12%, rgba(255, 120, 90, 0.07), transparent 70%);
  }

  .copy {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    gap: 24px;
  }

  .title {
    font-family: var(--serif);
    font-size: clamp(46px, 8.6vw, 124px);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }

  .title em {
    font-style: italic;
    background: linear-gradient(100deg, #fff 10%, #ffb3be 55%, var(--crimson-soft) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* Room for the italic overhang, which the clipped background would cut. */
    padding-right: 0.08em;
  }

  .lede {
    max-width: 54ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    max-width: 100%;
    margin-top: 6px;
  }

  .meta {
    font-size: 13.5px;
    color: var(--ink-3);
  }

  .meta span {
    margin-inline: 6px;
    opacity: 0.6;
  }

  .stage-wrap {
    margin-top: clamp(44px, 5.5vw, 76px);
  }

  .stage {
    perspective: 1800px;
  }

  .window {
    position: relative;
    transform-origin: 50% 0%;
    border-radius: clamp(8px, 1.4vw, 18px);
    filter: drop-shadow(0 40px 80px rgba(0, 0, 0, 0.7)) drop-shadow(0 0 120px rgba(224, 16, 58, 0.14));
    will-change: transform;
  }

  .window :global(img) {
    width: 100%;
    border-radius: inherit;
  }

  /* A hairline of light on the window edge, like glass catching a lamp. */
  .window::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    pointer-events: none;
  }

  .sheen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
  }

  .sheen::before {
    content: '';
    position: absolute;
    inset: -20% auto -20% 0;
    width: 45%;
    transform: translateX(var(--sheen-x, -140%)) skewX(-18deg);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.11), transparent);
  }
</style>
