---
import { repo } from '../data';

const links = [
  ['Features', '/#features'],
  ['Shortcuts', '/shortcuts'],
  ['Help', '/help'],
  ['Changelog', '/changelog'],
  ['Privacy', '/privacy'],
  ['GitHub', repo],
];
---

<header class="nav" data-nav>
  <div class="wrap inner">
    <a class="brand" href="/" aria-label="Velvet, home page">
      <img src="/favicon.svg" width="24" height="24" alt="" />
      <span>Velvet</span>
    </a>
    <nav class="links" aria-label="Pages">
      {links.map(([name, href]) => <a href={href}>{name}</a>)}
    </nav>
    <a class="btn btn-primary get" href="/#install">Download</a>
    <details class="menu">
      <summary aria-label="Menu">
        <svg viewBox="0 0 18 18" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.500" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h12M3 12h12"></path>
        </svg>
      </summary>
      <nav aria-label="Pages">
        {links.map(([name, href]) => <a href={href}>{name}</a>)}
      </nav>
    </details>
  </div>
  <!-- The page's own seek bar: sections are its chapters, the scroll position is the playhead. -->
  <div class="seek" data-page-seek aria-hidden="true">
    <span class="played" data-page-played></span>
    <span class="gaps" data-page-gaps></span>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--bg);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--nav);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 600;
    margin-right: auto;
  }

  .links {
    display: flex;
    gap: 28px;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-2);
  }

  .links a,
  .menu a {
    transition: color 160ms var(--ease);
  }

  .links a:hover {
    color: var(--ink);
  }

  .get {
    height: 36px;
    padding: 0 16px;
    border-radius: 8px;
    font-size: 14px;
  }

  .menu {
    display: none;
    position: relative;
  }

  summary {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .menu nav {
    position: absolute;
    top: 44px;
    right: 0;
    display: grid;
    min-width: 200px;
    padding: 8px;
    border-radius: 12px;
    background: var(--card);
    box-shadow:
      inset 0 0 0 1px var(--line-2),
      0 16px 32px rgba(0, 0, 0, 0.5);
  }

  .menu a {
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 15px;
    line-height: 24px;
    color: var(--ink);
  }

  .menu a:hover {
    background: var(--raised);
  }

  .seek {
    position: relative;
    height: 2px;
    background: var(--line-2);
    overflow: hidden;
  }

  .played {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .gaps :global(i) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--bg);
  }

  @media (max-width: 860px) {
    .links {
      display: none;
    }

    .inner {
      gap: 12px;
    }

    .menu {
      display: block;
    }
  }
</style>
