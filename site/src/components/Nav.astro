---
import { repo } from '../data';
---

<header class="nav" data-nav>
  <div class="wrap inner">
    <a class="brand" href="/" aria-label="Velvet, home page">
      <img src="/favicon.svg" width="24" height="24" alt="" />
      <span>Velvet</span>
    </a>
    <nav class="links" aria-label="Sections">
      <a href="/#memory">Memory</a>
      <a href="/#player">Player</a>
      <a href="/#features">Features</a>
      <a href="/#privacy">Privacy</a>
      <a href="/changelog">Changelog</a>
      <a href={repo} rel="noopener">GitHub</a>
    </nav>
    <a class="btn btn-primary get" href="/#install">Download</a>
  </div>
  <!-- The page's own seek bar: sections are its chapters, the scroll position is the playhead. -->
  <div class="seek" data-page-seek aria-hidden="true">
    <span class="played" data-page-played></span>
    <span class="gaps" data-page-gaps></span>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--bg);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--nav);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 600;
    margin-right: auto;
  }

  .links {
    display: flex;
    gap: 28px;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-2);
  }

  .links a {
    transition: color 160ms var(--ease);
  }

  .links a:hover {
    color: var(--ink);
  }

  .get {
    height: 36px;
    padding: 0 16px;
    border-radius: 8px;
    font-size: 14px;
  }

  .seek {
    position: relative;
    height: 2px;
    background: var(--line-2);
    overflow: hidden;
  }

  .played {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .gaps :global(i) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--bg);
  }

  @media (max-width: 760px) {
    .links {
      display: none;
    }
  }
</style>
