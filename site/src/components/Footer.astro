---
import { repo } from '../data';

const thanks = [
  ['mpv', 'https://mpv.io'],
  ['yt-dlp', 'https://github.com/yt-dlp/yt-dlp'],
  ['Deno', 'https://deno.com'],
  ['SponsorBlock', 'https://sponsor.ajay.app'],
  ['DeArrow', 'https://dearrow.ajay.app'],
  ['Return YouTube Dislike', 'https://returnyoutubedislike.com'],
  ['AiSList', 'https://aisloplist.com'],
];
---

<footer class="footer">
  <div class="wrap">
    <div class="top">
      <a class="brand" href="#top">
        <img src="/favicon.svg" width="26" height="26" alt="" />
        <span>Velvet</span>
      </a>
      <nav aria-label="Project links">
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases`}>Releases</a>
        <a href={`${repo}/issues/new`}>Report a problem</a>
        <a href={`${repo}/blob/main/LICENSE`}>MIT License</a>
      </nav>
    </div>
    <p class="thanks">
      Velvet stands on {thanks.map(([name, url], i) => (
        <>
          <a href={url} rel="noopener">{name}</a>{i < thanks.length - 2 ? ', ' : i === thanks.length - 2 ? ' and ' : '.'}
        </>
      ))}
    </p>
    <p class="legal">
      YouTube is a trademark of Google LLC. Velvet is not related to, approved by or supported by Google or YouTube.
      The video in the screenshots is Big Buck Bunny, © Blender Foundation, CC BY 3.0.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 48px 64px;
    font-size: 14.5px;
    color: var(--ink-3);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 750;
    letter-spacing: -0.03em;
    font-size: 24px;
    color: var(--ink);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  a {
    transition: color 0.2s;
  }

  nav a:hover,
  .thanks a:hover {
    color: var(--ink);
  }

  .thanks a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .legal {
    margin-top: 14px;
    max-width: 90ch;
    font-size: 13px;
  }
</style>
