---
import { repo } from '../data';

const thanks = [
  ['mpv', 'https://mpv.io'],
  ['yt-dlp', 'https://github.com/yt-dlp/yt-dlp'],
  ['Deno', 'https://deno.com'],
  ['SponsorBlock', 'https://sponsor.ajay.app'],
  ['DeArrow', 'https://dearrow.ajay.app'],
  ['Return YouTube Dislike', 'https://returnyoutubedislike.com'],
  ['AiSList', 'https://aisloplist.com'],
];

const columns = [
  {
    name: 'Velvet',
    links: [
      ['Download', '/download'],
      ['Changelog', '/changelog'],
      ['How Velvet stays light', '/memory'],
      ['Privacy', '/privacy'],
    ],
  },
  {
    name: 'Use it',
    links: [
      ['Help', '/help'],
      ['Keyboard shortcuts', '/shortcuts'],
      ['Open links in Velvet', '/open'],
    ],
  },
  {
    name: 'Project',
    links: [
      ['GitHub', repo],
      ['Report a problem', `${repo}/issues/new`],
      ['MIT License', `${repo}/blob/main/LICENSE`],
    ],
  },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="top">
      <a class="brand" href="/">
        <img src="/favicon.svg" width="24" height="24" alt="" />
        <span>Velvet</span>
      </a>
      <div class="columns">
        {
          columns.map((c) => (
            <nav aria-label={c.name}>
              <p>{c.name}</p>
              {c.links.map(([name, href]) => (
                <a href={href}>{name}</a>
              ))}
            </nav>
          ))
        }
      </div>
    </div>
    <p class="thanks">
      Velvet stands on {thanks.map(([name, url], i) => (
        <>
          <a href={url} rel="noopener">{name}</a>{i < thanks.length - 2 ? ', ' : i === thanks.length - 2 ? ' and ' : '.'}
        </>
      ))}
    </p>
    <p class="legal">
      YouTube is a trademark of Google LLC. Velvet is not related to, approved by or supported by Google or YouTube.
      The video in the screenshots is Big Buck Bunny, © Blender Foundation, CC BY 3.0.
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 64px;
    font-size: 14px;
    line-height: 22px;
    color: var(--ink-3);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px 64px;
    margin-bottom: 48px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
  }

  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
  }

  nav {
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 144px;
    color: var(--ink-2);
  }

  nav p {
    color: var(--ink-3);
  }

  a {
    transition: color 160ms var(--ease);
  }

  nav a:hover,
  .thanks a:hover {
    color: var(--ink);
  }

  .thanks a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }

  .legal {
    margin-top: 12px;
    max-width: 44rem;
    font-size: 13px;
    line-height: 20px;
  }
</style>
