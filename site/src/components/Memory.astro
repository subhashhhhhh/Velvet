---
import { memory } from '../data';

const fmt = (mb: number) => mb.toLocaleString('en-US');
const ticks = [0, 500, 1000, 1500];
---

<section class="section" id="memory">
  <div class="wrap">
    <div class="head">
      <p class="label" data-reveal>Memory</p>
      <h2 class="title" data-reveal>The same video in a quarter of the memory</h2>
      <p class="lede" data-reveal>
        A browser tab brings a whole web engine to play one video. Velvet is a native app: a SwiftUI interface, mpv for
        playback and hardware decoding. It keeps only what is on the screen.
      </p>
    </div>

    <div class="board">
      <figure class="chart" data-meter>
        <figcaption>Memory while the same 1440p video plays</figcaption>
        <div class="plot">
          <div class="grid" aria-hidden="true">
            {
              ticks.map((t) => (
                <span style={`--f: ${t / memory.axisMax}`}>
                  <i class="mono">{t === 0 ? '0' : `${fmt(t)} MB`}</i>
                </span>
              ))
            }
          </div>
          {
            memory.compare.map((row) => (
              <div class="row">
                <p class={`name ${row.velvet ? 'is-velvet' : ''}`}>{row.name}</p>
                <div class="line">
                  <div class={`bar ${row.velvet ? 'is-velvet' : ''}`} data-bar style={`--f: ${row.mb / memory.axisMax}`} />
                  <p class="val mono" data-val>
                    <span data-count={row.mb}>{fmt(row.mb)}</span> MB
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </figure>

      <div class="side" data-reveal>
        <h3>Velvet on macOS 15</h3>
        <ul>
          {
            memory.sequoia.map((row) => (
              <li>
                <span>{row.name}</span>
                <span class="mono">{fmt(row.mb)} MB</span>
                <i style={`--f: ${row.mb / memory.axisMax}`} />
              </li>
            ))
          }
        </ul>
        <p class="note">
          Two minutes into a 60 fps video on an M1 MacBook Air. Memory changes with the video, its length and the macOS
          version, so your numbers can be different.
        </p>
        <a class="more" href="/memory">How Velvet stays light</a>
      </div>
    </div>
  </div>
</section>

<style>
  .board {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 24px;
  }

  .chart,
  .side {
    border-radius: 16px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
    padding: 24px;
  }

  figcaption,
  h3 {
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    color: var(--ink-2);
    margin-bottom: 24px;
  }

  /* The bars and the grid share one scale: the plot's width less the room for a value. */
  .plot {
    --room: 104px;
    position: relative;
    display: grid;
    gap: 24px;
    padding-bottom: 32px;
  }

  .grid span {
    position: absolute;
    top: 0;
    bottom: 24px;
    left: calc((100% - var(--room)) * var(--f));
    width: 1px;
    background: var(--line);
  }

  /* The zero line would run through the row names. */
  .grid span:first-child {
    background: none;
  }

  .grid i {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 8px;
    font-style: normal;
    font-size: 12px;
    line-height: 16px;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .row {
    position: relative;
  }

  .name {
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-2);
    margin-bottom: 8px;
  }

  .name.is-velvet {
    color: var(--ink);
  }

  .line {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bar {
    flex: none;
    width: calc((100% - var(--room)) * var(--f));
    height: 32px;
    border-radius: 4px;
    background: #3a3733;
    transform-origin: left center;
  }

  .bar.is-velvet {
    background: var(--accent);
    box-shadow: none;
  }

  .val {
    font-size: 15px;
    line-height: 20px;
    white-space: nowrap;
  }

  .side ul {
    display: grid;
    gap: 16px;
  }

  .side li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 16px;
    font-size: 15px;
    line-height: 20px;
  }

  .side li i {
    grid-column: 1 / -1;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(var(--ink-3), var(--ink-3)) left / calc(100% * var(--f)) 100% no-repeat var(--raised);
  }

  .note {
    margin-top: 24px;
    font-size: 13px;
    line-height: 20px;
    color: var(--ink-3);
  }

  .more {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }

  @media (max-width: 900px) {
    .board {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .chart,
    .side {
      padding: 20px;
    }

    .plot {
      --room: 80px;
    }

    .grid span:nth-child(2) i,
    .grid span:nth-child(4) i {
      display: none;
    }
  }
</style>
