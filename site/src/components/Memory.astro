---
import { memory } from '../data';

const ratio = memory.velvet / memory.browser;
const fmt = (mb: number) => (mb >= 1000 ? { n: mb / 1000, unit: 'GB', decimals: 1 } : { n: mb, unit: 'MB', decimals: 0 });
const browser = fmt(memory.browser);
const velvet = fmt(memory.velvet);
---

<section class="section" id="memory">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Memory</p>
      <h2 class="display stack" data-reveal>The same video. <em>{memory.headline}</em></h2>
      <p class="lede" data-reveal>
        A browser tab brings a whole web engine to play one video. Velvet is a native app: a SwiftUI interface, mpv for
        playback, and hardware decoding. It keeps only what is on the screen.
      </p>
    </div>

    <div class="meter" data-meter>
      <div class="row">
        <div class="label">
          <span class="name">{memory.browserLabel}</span>
          <span class="value"><span data-count={browser.n} data-decimals={browser.decimals}>{browser.n.toFixed(browser.decimals)}</span><small>{browser.unit}</small></span>
        </div>
        <div class="track"><div class="bar bar-browser" data-bar style="--w: 100%"></div></div>
      </div>
      <div class="row">
        <div class="label">
          <span class="name velvet">Velvet</span>
          <span class="value"><span data-count={velvet.n} data-decimals={velvet.decimals}>{velvet.n.toFixed(velvet.decimals)}</span><small>{velvet.unit}</small></span>
        </div>
        <div class="track"><div class="bar bar-velvet" data-bar style={`--w: ${(ratio * 100).toFixed(1)}%`}></div></div>
      </div>
      <p class="note">{memory.note}</p>
    </div>

    <ul class="stats">
      {
        memory.stats.map((s) => (
          <li data-reveal>
            <p class="big">
              <span data-count={s.value} data-decimals="0">
                {s.value}
              </span>
              <small>{s.unit}</small>
            </p>
            <p class="what">{s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .meter {
    display: grid;
    gap: 28px;
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.01));
  }

  .label {
    display: grid;
    gap: 6px;
    margin-bottom: 14px;
  }

  .value small {
    font-family: var(--sans);
    font-size: 0.36em;
    color: var(--ink-3);
    margin-left: 0.4em;
  }

  .name {
    font-size: 15px;
    color: var(--ink-2);
  }

  .name.velvet {
    color: var(--ink);
    font-weight: 600;
  }

  .value {
    font-family: var(--display);
    font-weight: 750;
    letter-spacing: -0.03em;
    font-size: clamp(40px, 5.4vw, 68px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .track {
    height: clamp(16px, 2.4vw, 28px);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    overflow: hidden;
  }

  .bar {
    width: var(--w);
    height: 100%;
    border-radius: inherit;
    transform-origin: left center;
  }

  .bar-browser {
    background: linear-gradient(90deg, #3a3639, #6b6569);
  }

  .bar-velvet {
    background: linear-gradient(90deg, #a80c2c, var(--crimson) 60%, #ff4d6a);
    box-shadow: 0 0 28px var(--crimson-glow);
  }

  .note {
    font-size: 13.5px;
    color: var(--ink-3);
    max-width: 80ch;
  }

  .stats {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .stats li {
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-raised);
  }

  .big {
    font-family: var(--display);
    font-weight: 750;
    letter-spacing: -0.03em;
    font-size: clamp(48px, 6vw, 72px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .big small {
    font-family: var(--sans);
    font-size: 16px;
    color: var(--ink-3);
    margin-left: 6px;
  }

  .what {
    margin-top: 12px;
    font-size: 15px;
    color: var(--ink-2);
  }
</style>
