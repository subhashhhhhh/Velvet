---
import { Image } from 'astro:assets';
import frame from '../assets/frame.png';
---

<section class="section" id="pip" data-pip-section>
  <div class="wrap grid">
    <div class="head">
      <p class="label" data-reveal>Picture in Picture</p>
      <h2 class="title" data-reveal>Leave the page and the video follows</h2>
      <p class="lede" data-reveal>
        Go to a different app, scroll past the player, or open a different page in Velvet. The video moves to a small
        window that stays on top. Each of these has a setting.
      </p>
      <p class="hint" data-reveal>It followed you down this page: look at the corner</p>
    </div>

    <div class="scene" data-pip-scene aria-hidden="true">
      <div class="win velvet">
        <div class="bar"><i></i><i></i><i></i></div>
        <div class="slot"></div>
        <div class="lines"><b style="width:62%"></b><b style="width:38%"></b></div>
      </div>
      <div class="win other" data-pip-other>
        <div class="bar"><i></i><i></i><i></i></div>
        <div class="lines doc">
          <b style="width:44%"></b><b style="width:92%"></b><b style="width:86%"></b><b style="width:90%"></b>
          <b style="width:58%"></b><b style="width:0"></b><b style="width:88%"></b><b style="width:94%"></b>
          <b style="width:72%"></b>
        </div>
      </div>
      <div class="mini" data-pip-mini>
        <Image src={frame} widths={[480, 960]} sizes="(max-width: 900px) 46vw, 300px" alt="" />
      </div>
    </div>
  </div>
</section>

<aside class="dock" data-pip-dock aria-hidden="true">
  <Image src={frame} widths={[320, 640]} sizes="240px" alt="" loading="lazy" />
  <span class="progress"><i></i></span>
  <button type="button" data-pip-close tabindex="-1" aria-label="Close">
    <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.500" stroke-linecap="round"><path d="M2.500 2.500l7 7M9.500 2.500l-7 7"></path></svg>
  </button>
</aside>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: 64px;
  }

  .head {
    margin-bottom: 0;
  }

  .hint {
    display: none;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-3);
  }

  .scene {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    background: var(--bg-deep);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }

  .win {
    position: absolute;
    border-radius: 10px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line-2);
    padding: 0 4% 4%;
  }

  .win.velvet {
    left: 6%;
    top: 8%;
    width: 64%;
    height: 66%;
  }

  .win.other {
    left: 22%;
    top: 20%;
    width: 60%;
    height: 68%;
    background: var(--raised);
  }

  .bar {
    display: flex;
    gap: 6px;
    padding-block: 12px;
  }

  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-2);
  }

  .slot {
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    background: var(--bg-deep);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .lines {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }

  .lines b {
    height: 6px;
    border-radius: 3px;
    background: var(--line);
  }

  .lines.doc b:first-child {
    height: 12px;
    background: var(--line-2);
    margin-bottom: 4px;
  }

  /* The video rests in the corner. The script starts it in the player slot and moves it
     here with a transform as the section scrolls into view. */
  .mini {
    position: absolute;
    left: 62%;
    top: 64%;
    width: 32%;
    border-radius: 8px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--line-2),
      0 16px 32px rgba(0, 0, 0, 0.5);
    transform-origin: 0 0;
  }

  .mini :global(img) {
    width: 100%;
  }

  .dock {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 40;
    width: 240px;
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--line-2),
      0 16px 40px rgba(0, 0, 0, 0.55);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.96);
    transform-origin: 100% 100%;
    transition:
      opacity 300ms var(--ease),
      transform 400ms var(--ease),
      visibility 0s 400ms;
    display: none;
  }

  .dock:global(.on) {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .dock :global(img) {
    width: 100%;
  }

  /* The dock's seek bar shows the page's own progress (set by the script). */
  .progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: rgba(239, 233, 222, 0.24);
  }

  .progress i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--page-progress, 0));
    transform-origin: left;
  }

  .dock button {
    position: absolute;
    top: 8px;
    left: 8px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: rgba(18, 17, 15, 0.72);
    opacity: 0;
    transition: opacity 160ms var(--ease);
  }

  .dock:hover button {
    opacity: 1;
  }

  @media (min-width: 1100px) and (prefers-reduced-motion: no-preference) {
    .dock {
      display: block;
    }

    :global(html.js) .hint {
      display: block;
    }
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
</style>
