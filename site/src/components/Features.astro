---
import { Picture } from 'astro:assets';
import home from '../assets/home.png';

const features = [
  ['Queue and series', 'Add videos to the queue and drag them into order. Velvet finds the next episode of a series.'],
  ['Downloads', 'Keep a video for a flight or a slow connection. Downloads play in Velvet.'],
  ['Live chat and comments', 'Live streams with their chat. Comments with replies, and a search in the comments.'],
  ['Shorts', 'A vertical player for Shorts. You can also hide the Shorts shelf.'],
  ['Part of the Mac', 'Now Playing in Control Center, media keys, headphone buttons and trackpad swipes.'],
  ['Opens your links', 'Drag a link onto the window, copy one, or use the bookmarklet in your browser.'],
  ['Updates itself', 'Velvet checks for a new version each day and verifies its signature before the install.'],
  ['Slow connections', 'For 4K and HDR, Velvet downloads from two links at the same time.'],
];
---

<section class="section" id="features">
  <div class="wrap">
    <div class="head">
      <p class="label" data-reveal>Features</p>
      <h2 class="title" data-reveal>Your whole account, in a Mac app</h2>
      <p class="lede" data-reveal>
        Sign in, and the home feed, subscriptions, history, Watch Later, playlists and notifications are the same as on
        youtube.com. You can also use Velvet without an account.
      </p>
    </div>

    <figure class="shot" data-shot>
      <Picture
        src={home}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[720, 1080, 1440, 2160, 2560]}
        sizes="(max-width: 1240px) 94vw, 1184px"
        alt="The Velvet home feed: a row of topic chips above a grid of videos, with the sidebar at the left."
      />
    </figure>

    <ul class="list">
      {
        features.map(([name, text]) => (
          <li data-tile>
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .shot {
    margin-bottom: 64px;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px var(--line-2),
      0 32px 64px rgba(0, 0, 0, 0.5);
    transform-origin: 50% 100%;
  }

  .shot :global(img) {
    width: 100%;
    border-radius: inherit;
  }

  /* A spec sheet, not a card grid: name at the left, what it does at the right. */
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 64px;
    border-top: 1px solid var(--line);
  }

  .list li {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: 16px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    line-height: 22px;
  }

  .list h3 {
    font-size: inherit;
    line-height: inherit;
    font-weight: 500;
  }

  .list p {
    color: var(--ink-2);
  }

  @media (max-width: 980px) {
    .list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .shot {
      margin-bottom: 32px;
      border-radius: 8px;
    }

    .list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
      padding-block: 16px;
    }
  }
</style>
