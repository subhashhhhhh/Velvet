---
import CopyCommand from './CopyCommand.astro';
import { brew, version } from '../data';
---

<section class="section" id="install">
  <div class="wrap">
    <div class="head">
      <img class="icon" src="/icon.png" width="64" height="64" alt="" data-reveal />
      <h2 class="title" data-reveal>Get Velvet</h2>
      <p class="lede" data-reveal>
        Free and open source. Version <a class="ver" href="/changelog">{version}</a> runs on macOS 15 or later, on Apple silicon
        and Intel.
      </p>
      <div class="actions" data-reveal>
        <a class="btn btn-primary" href="/download">Download for Mac</a>
        <CopyCommand command={brew} />
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: 0;
  }

  .icon {
    border-radius: 14px;
    margin-bottom: 8px;
  }

  .ver {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
  }
</style>
