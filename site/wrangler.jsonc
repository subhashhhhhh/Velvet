{
  // The site is static files. Cloudflare's build runs `npx wrangler deploy`; without this
  // file, Wrangler adds the Astro Cloudflare adapter by itself, and that adapter builds the
  // pages inside the Workers runtime, which cannot read ../updates and ../docs/releases.
  "name": "velvet",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
